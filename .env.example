# ------------------------------------------------------------------
# Project Scheduler - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank for local SQLite, or use a Postgres URL)
DATABASE_URL=

# Timezone / locale (defaults to Asia/Kolkata)
# TIME_ZONE=Asia/Kolkata

# Email backend: if EMAIL_BACKEND is empty, the console backend is used
# (emails print to the terminal - good for local development).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP (email reminders)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=Project Scheduler <no-reply@example.com>

# ------------------------------------------------------------------
# Scheduler (background worker heartbeat/tick timing)
# ------------------------------------------------------------------
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_HEARTBEAT_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------
# Reminder defaults (used for steps that leave the fields blank)
# ------------------------------------------------------------------
# Default Reminder settings
DEFAULT_REMINDER_TIME=09:00
DEFAULT_REMINDER_DAYS=1

# SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Business calendar: calendar_days (v1) or working_days
BUSINESS_CALENDAR_MODE=calendar_days

# Production hardening flags (set to 1 behind HTTPS)
# SESSION_COOKIE_SECURE=0
# CSRF_COOKIE_SECURE=0
# SECURE_SSL_REDIRECT=0